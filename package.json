{
  "name": "interactivesvg",
  "widgetName": "InteractiveSVG",
  "version": "1.1.0",
  "description": "Widget to show svg(s) in a Mendix Application. User(s) can interact with this svg and trigger Mendix actions.",
  "copyright": "JL 2025",
  "author": "JL",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "config": {
    "projectPath": "../../",
    "mendixHost": "http://localhost:8080",
    "developmentPort": 3000
  },
  "packagePath": "stoneworx",
  "scripts": {
    "start": "pluggable-widgets-tools start:server",
    "dev": "pluggable-widgets-tools start:web",
    "build": "pluggable-widgets-tools build:web",
    "lint": "pluggable-widgets-tools lint",
    "lint:fix": "pluggable-widgets-tools lint:fix",
    "test": "pluggable-widgets-tools test:unit:web",
    "prerelease": "npm run lint && npm test",
    "release": "pluggable-widgets-tools release:web"
  },
  "devDependencies": {
    "@mendix/pluggable-widgets-tools": "~11.8.1",
    "@types/big.js": "^6.2.2"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "dompurify": "^3.4.16",
    "react-svg": "^17.2.4"
  },
  "resolutions": {
    "react": "19.0.0",
    "@types/react": "19.0.0",
    "react-dom": "19.0.0",
    "@types/react-dom": "19.0.0"
  },
  "overrides": {
    "react": "19.0.0",
    "@types/react": "19.0.0",
    "react-dom": "19.0.0",
    "@types/react-dom": "19.0.0",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1"
  }
}
